		(uuid "e89e06c5-32e9-4228-b389-35ea640b8098")
	)
	(text_box "POWER PATH - 2x TPS2121 (2.8 - 22 V, 2x56 mOhm, abs max 24 V)\nPriority: ALIM > USB (MUX1), then external > Power Board (MUX2)\nOnly one input valid -> that input powers OUT\nBoth valid (PR1 & CP2 > 1.06 V) -> XCOMP: IN1 kept while PR1 > CP2\n  MUX1: V_ALIM > 0.894 x V_USB6    MUX2: V_MUX1_OUT > 0.894 x V_PB\nILIM R6/R29 80k6: I = 65.2 / 80.6^0.861 = 1.5 A typ (1.0 - 2.0 A)\nSS C19/C22 100 nF: ~780 V/s -> ~8 ms ramp (+ input settling timer)\nSwitchover ~5 us; OUT dip held up by C15/C25 + downstream caps\nST (open drain, 10k to +3V3, max 5.5 V): high = IN1, low = IN2\nStatus LEDs: Q1 driven by ST, Q2 inverts -> one LED per mux\n  D5 = ALIM   D6 = USB   D7 = external   D8 = Power Board\n  I_LED = (3.3 V - Vf) / 1k1 ~ 1 mA (Vf 2.1 V)\nOV1/OV2 = GND: over-voltage cut-off disabled (TVS only)"
		(exclude_from_sim no)
		(at 109.855 170.18 0)
		(size 105.41 31.75)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "eb4c152a-1df8-48af-961a-406b84951248")
	)
